# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ============================================================================
# SUPABASE CONFIGURATION (ProjectLink UMS Database & Auth)
# Salin daripada Supabase Dashboard -> Project Settings -> API
# ============================================================================
# 1. Project URL (Contoh: https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=""

# 2. Project API Key (anon / public) - Selamat digunakan pada klien & pelayan dengan RLS
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# 3. Service Role Key (secret - Pilihan, untuk operasi Admin di sebelah pelayan sahaja)
SUPABASE_SERVICE_ROLE_KEY=""
